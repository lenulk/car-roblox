local function get(lang: string, key: string, ...: any): string
	local tbl = Strings[lang] or Strings.th
	local template = tbl[key] or Strings.th[key]
	if template == nil then
		return key
	end
	if select("#", ...) > 0 then
		local ok, result = pcall(string.format, template, ...)
		return if ok then result else template
	end
	return template
end

Strings.get = get
return Strings
