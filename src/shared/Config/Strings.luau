local function get(lang: string, key: string, ...: any): string
	local tbl = Strings[lang] or Strings.th
	local template = tbl[key] or Strings.th[key]
	if template == nil then
		return key
	end
	if select("#", ...) > 0 then
		local ok, result = pcall(string.format, template, ...)
		return if ok then result else template
	end
	return template
end

for _, extraName in { "StringsUI", "StringsTuning", "StringsRobux2" } do
	local extraModule = script.Parent:FindFirstChild(extraName)
	if extraModule then
		local ok, extra = pcall(require, extraModule :: ModuleScript)
		if ok and type(extra) == "table" then
			for _, lang in { "th", "en" } do
				local source = (extra :: any)[lang]
				if type(source) == "table" then
					for key, value in source do
						if (Strings :: any)[lang][key] == nil then
							(Strings :: any)[lang][key] = value
						end
					end
				end
			end
		end
	end
end

Strings.get = get
return Strings
